# Local development defaults. For a public deployment, use an HTTPS origin and hostname.
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=LiftNex
REQUIRE_USER_VERIFICATION=1
ADMIN_UIDS=
INVITE_ONLY=0
SESSION_DAYS=90
VAPID_SUBJECT=mailto:admin@localhost

# Optional: serve the UI on another origin (for example GitHub Pages).
# CORS_ORIGINS=https://nathanmarinas2.github.io
# COOKIE_SAMESITE=None

# Optional nutrition sources. Keys are read only by the API container.
# USDA_API_KEY=your-fooddata-central-key
# Gemini AI Coach (recommended; server-side only)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional OpenAI-compatible fallback
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your-server-side-ai-key
# AI_MODEL=gpt-4o-mini
